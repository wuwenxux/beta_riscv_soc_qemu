{
  "_comment": "Beta SoC minimal test config — development/verification only",
  "version": "1.0",

  "acpu": {
    "num_clusters": 2,
    "cores_per_cluster": 4,
    "hartid_base": 0,
    "isa": "rv64imafdc",
    "mmu_mode": "sv39",
    "pma_type": "none",
    "reset_vector": "0x80000000",
    "mvendorid": "0x0",
    "marchid": "0x0",
    "mimpid": "0x0"
  },

  "mcpu": {
    "num_cores": 1,
    "isa": "rv32imac",
    "itcm_kb": 64,
    "dtcm_kb": 64,
    "sram_kb": 256,
    "reset_vector": "0x00001000",
    "hartid_base": 32
  },

  "memory_regions": [
    {
      "name": "bootrom",
      "base": "0x00001000",
      "size": "0x00003000",
      "type": "rom",
      "cpu_visible": "mcpu"
    },
    {
      "name": "ddr",
      "base": "0x80000000",
      "size": "0x08000000",
      "type": "ram",
      "cpu_visible": "acpu"
    }
  ],

  "interrupts": {
    "aplic": {
      "num_sources": 64,
      "domains": [
        {
          "name": "m_root",
          "level": "m",
          "base": "0x0D000000",
          "size": "0x00004000",
          "parent": null
        },
        {
          "name": "s_app",
          "level": "s",
          "base": "0x0D004000",
          "size": "0x00004000",
          "parent": "m_root"
        }
      ]
    },
    "imsic": {
      "m_base": "0x24000000",
      "s_base": "0x28000000",
      "num_ids": 255,
      "num_vs_files": 0,
      "guest_index_bits": 0
    },
    "clint": {
      "base": "0x02000000",
      "size": "0x00010000",
      "timebase_freq": 10000000
    },
    "plic": {
      "base": "0x0C000000",
      "size": "0x00400000",
      "num_sources": 64,
      "num_priorities": 7
    },
    "irq_map": [
      { "name": "uart0", "irq_num": 10, "target": "aplic", "domain": "s_app" }
    ]
  },

  "devices": [
    {
      "name": "uart0",
      "type": "uart",
      "base": "0x10000000",
      "size": "0x00000100",
      "cpu_target": "both",
      "compatible": "ns16550a",
      "irq_name": "uart0",
      "clock_hz": 3686400,
      "instance_id": 0
    },
    {
      "name": "soc_csr",
      "type": "soc_top_csr",
      "base": "0x11000000",
      "size": "0x00001000",
      "cpu_target": "both",
      "registers": [
        { "name": "BOOT_ADDR",    "offset": "0x00", "width": 8, "access": "rw", "reset_value": "0x0" },
        { "name": "BOOT_ARG",     "offset": "0x08", "width": 8, "access": "rw", "reset_value": "0x0" },
        { "name": "CORE_RELEASE", "offset": "0x10", "width": 8, "access": "rw", "reset_value": "0x0" },
        { "name": "RESET_CTRL",   "offset": "0x18", "width": 4, "access": "rw", "reset_value": "0x0" }
      ]
    }
  ],

  "ddr": {
    "num_channels": 1,
    "channel_width_bits": 64,
    "speed_mbps": 3200,
    "max_per_channel_gb": 1,
    "interleave_step_bytes": 64,
    "channels": [
      { "id": 0, "ctrl_base": "0x20000000", "mem_base": "0x80000000", "size": "0x08000000" }
    ]
  },

  "boot": {
    "mode": "acpu_direct",
    "bootrom_base": "0x00001000",
    "bootrom_size": "0x00003000",
    "flash_base": "0x00000000",
    "flash_size": "0x00000000",
    "mcpu_entry": "0x00001000",
    "acpu_entry": "0x80000000"
  }
}
